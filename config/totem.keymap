#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define Nav  1
#define Sym  2
#define Num  3
#define fkeys 4
#define game1 5
#define game2 6

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tvp {
            timeout-ms = <100>;
            key-positions = <11 12 13>;
            bindings = <&tog 0>;
        };
    };

    macros {
        gif: gif {
            compatible = "zmk,behavior-macro";
           #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    }; 

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "BASE";

            bindings = <
            &kp Q       &kp W       &kp F        &kp P        &kp B        &kp J        &kp L           &kp U        &kp Y       &kp ENTER
            &mt LSHFT A  &mt LCTRL R  &mt LALT S  &mt LGUI T  &kp G        &kp M        &mt RGUI N      &mt RALT E  &mt RCTRL I  &mt RSHFT O
&kp ESCAPE  &kp Z       &kp X       &kp C        &kp D        &kp V        &kp K        &kp H           &kp COMMA    &kp DOT     &kp FSLH    &none
                                    &kp TAB      &lt 3 SPACE  &lt 1 DEL    &lt 4 ENTER  &lt 2 BACKSPACE &caps_word
            >;
        };

        Nav {
            bindings = <
        &trans     &trans     &trans  &trans  &trans    &kp PRINTSCREEN  &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &msc SCRL_UP
        &kp LSHFT  &kp LCTRL  &gresc  &trans  &trans    &kp PG_UP        &kp LEFT        &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT
&trans  &trans     &trans     &trans  &trans  &trans    &kp PG_DN        &kp F2          &kp CAPS        &caps_word       &msc SCRL_DOWN   &trans
                              &trans  &trans  &trans    &trans           &trans          &trans
            >;
        };

        Sym {
            bindings = <
           &kp DQT      &kp BSLH      &kp LEFT_BRACE       &kp RIGHT_BRACE        &kp PIPE2  &none   &none  &none  &none  &none
           &kp COLON    &kp SEMI      &kp AT               &kp SQT                &kp EXCL   &none   &kp LS(N3)    &kp DOLLAR  &kp GRAVE  &kp LS(NUHS)
&none      &kp LBKT     &kp RBKT      &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS  &kp AMPS   &none   &none  &none  &none  &none  &none
                                      &kp TILDE            &kp STAR               &kp CARET  &none   &none  &none
            >;
        };

        Num {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp LS(PRCNT)  &kp N7  &kp N8  &kp N9  &kp LS(PLUS)
        &trans  &trans  &trans  &trans  &trans    &kp EQUAL      &kp N4  &kp N5  &kp N6  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp LS(UNDER)  &kp N1  &kp N2  &kp N3  &kp N0     &trans
                        &trans  &trans  &trans    &trans         &trans  &trans
            >;
        };

        fkeys {
            bindings = <
        &kp F1     &kp F2     &kp F3    &kp F4   &kp F5    &none   &none   &none    &none     &none
        &kp F6     &kp F7     &kp F8    &kp F9   &kp F10   &none   &none   &kp LALT &kp LCTRL &kp LSHFT
&kp F11 &kp F12    &kp F13    &kp F14   &kp F15  &kp F16   &none   &none   &none    &none     &none  &none
                              &kp F17   &kp F18  &kp F19   &none   &none   &none
            >;
        };

        game1 {
            bindings = <
          &kp TAB    &kp Q  &kp W    &kp E      &kp R     &kp T     &kp Y    &kp U   &kp I      &kp O
          &kp LSHFT  &kp A  &kp S    &kp D      &kp F     &kp G     &kp H    &kp J   &kp K      &kp L
&kp LALT  &kp LCTRL  &kp Z  &kp X    &kp C      &kp V     &kp B     &kp N    &kp M   &kp COMMA  &kp DOT  &kp P
                            &kp ESC  &kp SPACE  &    &kp BSPC  &kp RET  &trans
            >;
        };

        game2 {
            bindings = <
          &kp M    &kp I   &kp T   &kp G   &kp B      &trans  &trans  &trans  &trans  &trans
          &kp N1   &kp N2  &kp N3  &kp N4  &kp N5     &trans  &trans  &trans  &trans  &trans
&kp CAPS  &kp N6   &kp N7  &kp N8  &kp N9  &kp N0     &trans  &trans  &trans  &trans  &trans  &trans
                           &kp J   &kp Y   &trans     &trans  &trans  &trans
            >;
        };
    };
};
